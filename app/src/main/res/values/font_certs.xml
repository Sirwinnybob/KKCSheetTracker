<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- All three arrays here are used: the parent is passed as GoogleFont.Provider(certificates=)
         in Type.kt, and the dev/prod children via @array/ cross-reference. Lint's UnusedResources
         check doesn't trace resource-ID usage through that provider parameter. -->
    <array name="com_google_android_gms_fonts_certs" tools:ignore="UnusedResources">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>
    <string-array name="com_google_android_gms_fonts_certs_dev" tools:ignore="Typos,UnusedResources">
        <item>
            
        </item>
    </string-array>
    <string-array name="com_google_android_gms_fonts_certs_prod" tools:ignore="Typos,UnusedResources">
        <item>
            
        </item>
    </string-array>
</resources>
